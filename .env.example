# Auto Manager — environment template.
#
# Copy to `.env` locally. On Render, add each value in Dashboard → Environment
# instead of committing anything. NOTHING in this file may hold a real secret.
#
# Hard rules for this project:
#   * Never commit a Telegram session string, login code, 2FA password, bot
#     token, Supabase service key, or Render API key.
#   * The operator enters Telegram credentials themselves — into the owner-only
#     control bot, or into scripts/login.py on their own machine. The agent never
#     receives them through chat.

# --- service behaviour ------------------------------------------------------
# shadow = the service runs, queues, reconciles, and reports, but performs no
#          outbound Telegram action. Start here.
# live   = outbound actions enabled. Refuses to boot unless every secret and
#          every safety guard below is configured.
APP_MODE=shadow
LOG_LEVEL=info
# Render injects PORT automatically; the start command passes it to uvicorn.
PORT=10000

# --- database (Supabase) ----------------------------------------------------
# Use the *connection pooler* string from Supabase → Project settings → Database
# → Connection pooling. It is IPv4-compatible and required from Render.
# Format: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SEARCH_PATH=app, public
DB_SSL=prefer
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=15

# --- control plane ----------------------------------------------------------
# Long random string. Required in live mode. Guards /control/* (pause, resume,
# shutdown). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTROL_TOKEN=

# --- telegram user client (Telethon) ----------------------------------------
# From https://my.telegram.org → API development tools. api_hash is a secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Leave this EMPTY in a normal deployment: the control bot's /login obtains the
# session and stores it in app.telegram_session, which is the whole point of the
# bot (the operator never runs Python). Set it only to override, because an
# environment value always wins over a stored one -- see TELEGRAM_SESSION_SOURCE.
# It is account-equivalent to a password: revoking one means Telegram -> Settings
# -> Privacy and Security -> Devices, not deleting the variable.
TELEGRAM_SESSION_STRING=
# Where a session may come from: "both" (env first, else the stored one),
# "database" (never the environment value), "env" (never the stored one; live mode
# then refuses to boot without TELEGRAM_SESSION_STRING above).
TELEGRAM_SESSION_SOURCE=both

# --- control bot (the operator's remote; docs/control-bot.md) ---------------
# Token from @BotFather /newbot. The bot answers TELEGRAM_OWNER_USER_IDS and nobody
# else, in private chats only, and cannot read or post in your channels.
TELEGRAM_BOT_TOKEN=
BOT_ENABLED=true
# Set to false once /login has stored a session: a deployment that cannot start a
# new login has one fewer door. /sessions and /use keep working.
BOT_ALLOW_LOGIN=true

# Numeric Telegram user IDs. Comma-separated. Only these IDs may issue owner
# commands; only MAIN_ADMIN gets auto-promoted in new channels.
TELEGRAM_OWNER_USER_IDS=
TELEGRAM_MAIN_ADMIN_USER_ID=

# --- worker / queue tuning --------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2.0
# Widening pause after consecutive loop errors (seconds). Raise it if the
# database is the thing failing; it is also what stops a broken migration from
# turning into a 2-second hammer.
WORKER_ERROR_BACKOFF=2,5,10,30,60
CLAIM_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=900
GRACEFUL_SHUTDOWN_SECONDS=25
RECONCILE_ON_BOOT=true
# Conservative pacing for join-request campaigns. Deliberately not tuned to
# move large volumes fast: Telegram restricts unwanted messaging, and the
# account, not the queue, is the scarce resource here.
CAMPAIGN_RATE_PER_HOUR=20

# One-shot, read-only protocol discovery against the storage bot and Channel
# Help. The service DMs the owner a report and changes nothing else. Set to 1,
# redeploy once, read the DM, then set back to 0. It exists because a
# development machine behind a filtering network cannot reach Telegram at all.
PROBE_ON_BOOT=0
